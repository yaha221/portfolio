#!/usr/bin/env sh
# Runs linters, static analysis and frontend tests before a commit, for the parts it touches:
# backend PHP code -> composer lint (code style + PHPStan), frontend -> npm run verify.
# Checks the working tree, not only staged changes. Skip once with `git commit --no-verify`.
set -e
cd "$(git rev-parse --show-toplevel)"

staged=$(git diff --cached --name-only --diff-filter=ACMR)

require_running() {
    if ! docker compose ps --status running --services 2>/dev/null | grep -qx "$1"; then
        echo "pre-commit: $1 container is not running, start it with 'docker compose up -d'" >&2
        exit 1
    fi
}

if echo "$staged" | grep -qE '^backend/(.*\.php|.*\.neon|composer\.(json|lock))$'; then
    require_running php
    docker compose exec -T php composer lint
fi

if echo "$staged" | grep -qE '^frontend/'; then
    require_running frontend
    docker compose exec -T frontend npm run verify
fi
